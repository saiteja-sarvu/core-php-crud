# Disable directory listing
Options -Indexes

# Block hidden files, data files and docs from direct access
<FilesMatch "(^\.|\.(json|txt|log|ini|bak|sql|md)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Hide server details
ServerSignature Off

# Basic security headers (needs mod_headers)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
